# Do not copy this file by hand. Run:  sh scripts/init-env.sh
# It writes .env with freshly generated secrets and prints the API key.
# Docker Compose refuses to start while the required values below are empty.

# API key. Every API request needs "Authorization: Bearer <API_KEY>" (the UI asks for it once).
# At least 16 characters; the API refuses to start otherwise.
API_KEY=

# Encrypts connection credentials (GitHub tokens, Slack webhook URLs, ...) before they are stored. One Fernet
# key, or several separated by commas: the first encrypts, all of them decrypt (that is how a key is rotated).
# Keep a copy somewhere safe. Without it the stored credentials cannot be read and must be entered again.
# The API and the worker refuse to start without a valid key.
SECRETS_KEY=

# PostgreSQL (not published to the host; only other containers can reach it)
POSTGRES_USER=user
POSTGRES_PASSWORD=
POSTGRES_DB=workflows
DATABASE_URL=

# Webhook secrets. A provider's webhook is rejected while its secret is empty.
GITHUB_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=
# Trello signs deliveries with your app secret and the callback URL you registered the webhook with.
TRELLO_API_SECRET=
TRELLO_CALLBACK_URL=

# Outbound requests from workflows are limited to public addresses. List internal hosts that
# workflows may call (comma-separated), for example a private database or service:
OUTBOUND_ALLOW_HOSTS=

# The API (8000) and UI (3000) listen on this address on the host. Use 0.0.0.0 only behind
# something that terminates TLS and restricts access.
BIND_ADDRESS=127.0.0.1

# Optional worker tuning (defaults shown). Each worker process runs WORKER_CONCURRENCY steps at a time.
# WORKER_CONCURRENCY=8
# JOB_LEASE_SECONDS=300        # a step must finish within this, or another worker may take the job
# RETENTION_DAYS=30            # finished runs (and their step history) older than this are deleted; 0 keeps everything
# DB_POOL_MAX=10               # connections per process (the worker uses WORKER_CONCURRENCY + 2 if unset)
# HEALTH_MAX_JOB_AGE_SECONDS=30
